# LAN IP of the box running Ollama; injected into the api container as `workhorse`
WORKHORSE_IP=192.168.1.100   # <- your Ollama box

# Only needed when running api/db tooling on the host (not inside compose)
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat
OLLAMA_BASE_URL=http://workhorse:11434

# Model used for every chat until the model selector lands (Milestone D)
OLLAMA_MODEL=qwen2.5-coder:latest
